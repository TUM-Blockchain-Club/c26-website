{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "HUSKY=0 pnpm install --frozen-lockfile --ignore-scripts",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/((?!stage-76803f8f95).*)",
      "destination": "/"
    }
  ],
  "github": {
    "enabled": true
  }
}
